---
import { Image } from "astro:assets";
import { SERVICES, wa, WA_MSG } from "../data/site";
import { img } from "../data/images";
---
<section class="section services" id="terapias">
  <div class="container">
    <header class="section__head reveal">
      <span class="eyebrow">Nuestras terapias</span>
      <h2>Especialidades para el desarrollo de tu hijo</h2>
      <p>Cada niño tiene su propio ritmo. Por eso empezamos con una evaluación y trabajamos con objetivos claros, de la mano con la familia.</p>
    </header>

    <div class="services__grid">
      {SERVICES.map((s) => (
        <article class={`svc svc--${s.color} reveal`} id={`terapia-${s.id}`}>
          <div class="svc__img">
            <Image src={img(s.image)} alt={s.alt} widths={[400, 600, 800]} sizes="(max-width: 640px) 92vw, (max-width: 960px) 46vw, 380px" />
          </div>
          <div class="svc__body">
            <span class="svc__ico"><svg class="ico" aria-hidden="true"><use href={`#${s.icon}`}/></svg></span>
            {s.online && <span class="tag">También online</span>}
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
            <a class="svc__link" href={wa(WA_MSG.servicio(s.name))} target="_blank" rel="noopener" data-track={s.name}>
              Consultar por esta terapia <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg>
            </a>
          </div>
        </article>
      ))}

      <article class="svc svc--cta reveal">
        <div class="svc__body">
          <svg class="svc__cta-deco" aria-hidden="true"><use href="#i-bubble"/></svg>
          <h3>¿No sabes por dónde empezar?</h3>
          <p>Cuéntanos qué has notado en tu peque y te orientamos sobre la evaluación más adecuada.</p>
          <a href={wa(WA_MSG.orientacion)} class="btn btn--white" target="_blank" rel="noopener" data-track="orientacion">
            <svg class="ico" aria-hidden="true"><use href="#i-wa"/></svg> Pide orientación
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
